# Copy this file to .env and fill in values from the Firebase console.
# Aasra uses only the free Spark plan. Enable Email/Password and Anonymous
# Authentication, and Realtime Database. Do not enable Storage.
#
# Two phones will not sync until these values are set and `npm run dev`
# (or the production build) is restarted.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
